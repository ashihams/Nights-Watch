# === Nights Watch — environment template ===
# Copy to .env and fill in real values. Never commit .env.

# Server
PORT=3001
NODE_ENV=development

# OpenTelemetry → SigNoz (ingestion)
# Self-host defaults: http://localhost:4318  (OTLP HTTP) / localhost:4317 (gRPC)
# SigNoz Cloud: https://ingest.<region>.signoz.cloud:443
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=nights-watch

# SigNoz Query API (Policy Engine — direct, never via MCP)
SIGNOZ_QUERY_API_URL=http://localhost:8080
SIGNOZ_API_KEY=

# SigNoz MCP (Explanation Layer only)
SIGNOZ_MCP_ENDPOINT=
SIGNOZ_MCP_TOKEN=

# n8n Executor
N8N_WEBHOOK_BASE_URL=http://localhost:5678
N8N_API_KEY=

# LLM (Planner + Explanation Layer + Re-plan) — pick one provider and stay consistent
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=claude-sonnet-4-20250514

# Policy thresholds (named constants also live in backend/src/config)
PAUSE_THRESHOLD=40
ROLLBACK_THRESHOLD=70
HARD_STOP_THRESHOLD=90

# Checkpoint store
CHECKPOINT_DB_PATH=./data/checkpoints.sqlite

# Policy rule weights (sum of fired → score, capped at 100)
POLICY_WEIGHT_TOOL_MISMATCH=40
POLICY_WEIGHT_BUDGET_BREACH=40
POLICY_WEIGHT_TARGET_MISMATCH=35
POLICY_WEIGHT_STEP_ORDER=25
POLICY_WEIGHT_MINOR_PARAM=10
