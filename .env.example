# === Nights Watch — environment template ===
# Copy to .env and fill in real values. Never commit .env.
#
# Docker Compose (local or VPS): backend defaults already use
#   host.docker.internal:{4318,8080,8000}
# with extra_hosts host-gateway — you usually do NOT need to change these
# for `docker compose`. Keep localhost values for bare-metal `npm run dev`.
# On a fresh Linux VPS, verify once from inside the backend container:
#   docker compose exec backend node -e "fetch('http://host.docker.internal:8080/api/v1/health').then(r=>console.log(r.status))"
# Never put SigNoz URLs on a public reverse proxy; keep them loopback / host-gateway only.

# Server
PORT=3001
NODE_ENV=development

# CORS for split deploy (Vercel UI → Render API). Comma-separated origins, or * .
# Leave empty for same-origin Docker (nginx proxy) — CORS stays off.
# CORS_ORIGINS=https://your-app.vercel.app,http://localhost:5173

# OpenTelemetry → SigNoz (ingestion)
# Self-host defaults: http://localhost:4318  (OTLP HTTP) / localhost:4317 (gRPC)
# Compose defaults (in docker-compose.yml): http://host.docker.internal:4318
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=nights-watch

# SigNoz Query API (Policy Engine — direct, never via MCP)
SIGNOZ_QUERY_API_URL=http://localhost:8080
SIGNOZ_API_KEY=

# SigNoz MCP (Explanation Layer only — HTTP mode)
SIGNOZ_MCP_ENDPOINT=http://localhost:8000
SIGNOZ_MCP_TOKEN=

# n8n Executor
N8N_WEBHOOK_BASE_URL=http://localhost:5678
N8N_API_KEY=

# LLM (Planner + Explanation Layer + Re-plan) — pick one provider and stay consistent
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=claude-sonnet-4-20250514

# Policy thresholds (named constants also live in backend/src/config)
PAUSE_THRESHOLD=40
ROLLBACK_THRESHOLD=70
HARD_STOP_THRESHOLD=90

# Checkpoint store
CHECKPOINT_DB_PATH=./data/checkpoints.sqlite

# Policy rule weights (sum of fired → score, capped at 100)
POLICY_WEIGHT_TOOL_MISMATCH=40
POLICY_WEIGHT_BUDGET_BREACH=40
POLICY_WEIGHT_TARGET_MISMATCH=35
POLICY_WEIGHT_STEP_ORDER=25
POLICY_WEIGHT_MINOR_PARAM=10
